# Neon Postgres — use the POOLED URL and require SSL.
# Local dev: point at your Neon `dev` branch.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ASL Belgisi API key (Bearer). Only used at submit time. Never logged.
ASL_API_KEY=

# Optional overrides.
ASL_API_BASE=https://xtrace.aslbelgisi.uz
TZ=Asia/Tashkent
